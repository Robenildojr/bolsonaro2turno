# ─────────────────────────────────────────────────────────────────────────────
# Íris — variáveis de ambiente. Copie para .env e preencha o que for usar.
# Nada aqui é enviado para lugar nenhum além dos serviços que você configurar.
# ─────────────────────────────────────────────────────────────────────────────

# OBRIGATÓRIO — chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Onde a Íris guarda banco, chaves e logs. Padrão: ~/.iris
# IRIS_HOME=/home/voce/.iris

# Identidade
IRIS_NAME=Íris
IRIS_OWNER_NAME=
IRIS_TZ=America/Sao_Paulo

# Modelo
IRIS_MODEL=claude-opus-5
IRIS_EFFORT=high
IRIS_MAX_TOKENS=32000

# Servidor local (a interface do orbe)
IRIS_HOST=127.0.0.1
IRIS_PORT=4319
# Gerado automaticamente no `npm run setup` se ficar vazio
IRIS_ACCESS_TOKEN=

# Senha-mestra do cofre. Se ficar vazia, a Íris pede no arranque (mais seguro).
# IRIS_PASSPHRASE=

# Embeddings: 'local' funciona offline; 'voyage' é mais preciso
IRIS_EMBEDDINGS=local
# VOYAGE_API_KEY=

# ── WhatsApp ────────────────────────────────────────────────────────────────
WHATSAPP_ENABLED=false
# 'cloud' = API oficial da Meta (recomendado) | 'baileys' = número pessoal (não oficial)
WHATSAPP_PROVIDER=cloud
# Seu número em E.164 sem '+', ex.: 5596991234567
WHATSAPP_OWNER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=                 # obrigatório: sem ele o canal não sobe

# ── Google Drive (backup cifrado da memória) ────────────────────────────────
DRIVE_ENABLED=false
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=

# ── E-mail ──────────────────────────────────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_USER=
# a senha vai para o cofre: `npm run iris -- cofre set email.senha`

# ── Justiça (DataJud/CNJ — chave pública documentada pelo próprio CNJ) ──────
DATAJUD_API_KEY=

IRIS_LOG_LEVEL=info
