# ─────────────────────────────────────────────────────────────────────────────
# Gideão — variáveis de ambiente. Copie para .env e preencha o que for usar.
# Nada aqui é enviado para lugar nenhum além dos serviços que você configurar.
# ─────────────────────────────────────────────────────────────────────────────

# OBRIGATÓRIO — chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Onde o Gideão guarda banco, chaves e logs. Padrão: ~/.gideao
# GIDEAO_HOME=/home/voce/.gideao

# Identidade
GIDEAO_NAME=Gideão
GIDEAO_OWNER_NAME=
GIDEAO_TZ=America/Sao_Paulo

# Modelo
GIDEAO_MODEL=claude-opus-5
GIDEAO_EFFORT=high
GIDEAO_MAX_TOKENS=32000

# Servidor local (a interface do orbe)
GIDEAO_HOST=127.0.0.1
GIDEAO_PORT=4319
# Gerado automaticamente no `npm run setup` se ficar vazio
GIDEAO_ACCESS_TOKEN=

# Senha-mestra do cofre. Se ficar vazia, o Gideão pede no arranque (mais seguro).
# GIDEAO_PASSPHRASE=

# Embeddings: 'local' funciona offline; 'voyage' é mais preciso
GIDEAO_EMBEDDINGS=local
# VOYAGE_API_KEY=

# ── WhatsApp ────────────────────────────────────────────────────────────────
WHATSAPP_ENABLED=false
# 'cloud' = API oficial da Meta (recomendado) | 'baileys' = número pessoal (não oficial)
WHATSAPP_PROVIDER=cloud
# Seu número em E.164 sem '+', ex.: 5596991234567
WHATSAPP_OWNER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=                 # obrigatório: sem ele o canal não sobe

# ── Google Drive (backup cifrado da memória) ────────────────────────────────
DRIVE_ENABLED=false
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=

# ── E-mail ──────────────────────────────────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_USER=
# a senha vai para o cofre: `npm run gideao -- cofre set email.senha`

# ── Justiça (DataJud/CNJ — chave pública documentada pelo próprio CNJ) ──────
DATAJUD_API_KEY=

GIDEAO_LOG_LEVEL=info
